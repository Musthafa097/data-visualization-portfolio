// =====================================================================
// DAX for the Retail Sales dashboard
// Create the Date table first (Modeling > New table), then the
// measures (Modeling > New measure). Create each measure one at a time.
// Tip: put them all in a table called "_Measures" (Enter Data > empty table)
// so they are easy to find.
// =====================================================================


// ---------------------------------------------------------------------
// A. DATE TABLE  (Modeling > New table)
// ---------------------------------------------------------------------
Date =
ADDCOLUMNS (
    CALENDAR (
        DATE ( YEAR ( MIN ( Sales[OrderDate] ) ), 1, 1 ),
        DATE ( YEAR ( MAX ( Sales[OrderDate] ) ), 12, 31 )
    ),
    "Year",         YEAR ( [Date] ),
    "Quarter",      "Q" & QUARTER ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month",        FORMAT ( [Date], "MMM" ),
    "Year-Month",   FORMAT ( [Date], "YYYY-MM" ),
    "Weekday",      FORMAT ( [Date], "ddd" )
)
// After creating it:
//   1. Table tools > Mark as date table > choose the [Date] column.
//   2. Select the "Month" column > Column tools > Sort by column > "Month Number".
//   3. Model view: drag Date[Date] onto Sales[OrderDate] (one-to-many, single direction).


// ---------------------------------------------------------------------
// B. CORE MEASURES
// ---------------------------------------------------------------------
Total Revenue = SUM ( Sales[Revenue] )

Total Cost = SUM ( Sales[TotalCost] )

Total Profit = [Total Revenue] - [Total Cost]

Profit Margin % = DIVIDE ( [Total Profit], [Total Revenue] )

Total Orders = DISTINCTCOUNT ( Sales[OrderID] )

Units Sold = SUM ( Sales[Quantity] )

Average Order Value = DIVIDE ( [Total Revenue], [Total Orders] )

Unique Customers = DISTINCTCOUNT ( Sales[CustomerID] )

Return Rate % =
DIVIDE (
    CALCULATE ( COUNTROWS ( Sales ), Sales[ReturnedFlag] = "Yes" ),
    COUNTROWS ( Sales )
)

Returned Revenue =
CALCULATE ( [Total Revenue], Sales[ReturnedFlag] = "Yes" )


// ---------------------------------------------------------------------
// C. TIME INTELLIGENCE
// ---------------------------------------------------------------------
Revenue YTD = TOTALYTD ( [Total Revenue], 'Date'[Date] )

// Like-for-like prior year: the data ends 31 Oct 2026, so comparing 2026
// with a FULL 2025 would be unfair. This stops the prior-year comparison
// at the same cut-off date.
Revenue PY =
VAR LastDataDate = CALCULATE ( MAX ( Sales[OrderDate] ), ALL ( 'Date' ), ALL ( Sales ) )
VAR Cutoff       = EDATE ( LastDataDate, -12 )
RETURN
    CALCULATE (
        [Total Revenue],
        SAMEPERIODLASTYEAR ( 'Date'[Date] ),
        'Date'[Date] <= Cutoff
    )

Revenue YoY % = DIVIDE ( [Total Revenue] - [Revenue PY], [Revenue PY] )

Revenue Last Month =
CALCULATE ( [Total Revenue], DATEADD ( 'Date'[Date], -1, MONTH ) )

Revenue MoM % = DIVIDE ( [Total Revenue] - [Revenue Last Month], [Revenue Last Month] )


// ---------------------------------------------------------------------
// D. SHARE / RANKING MEASURES
// ---------------------------------------------------------------------
Revenue % of Total =
DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED () ) )

Category Rank =
RANKX ( ALLSELECTED ( Sales[Category] ), [Total Revenue], , DESC, DENSE )


// ---------------------------------------------------------------------
// E. DYNAMIC TITLE (optional, nice touch)
// Use in a visual title: Format > Title > fx > choose this measure.
// ---------------------------------------------------------------------
Dashboard Subtitle =
"Showing " & FORMAT ( MIN ( 'Date'[Date] ), "d mmm yyyy" ) & " to " & FORMAT ( MAX ( 'Date'[Date] ), "d mmm yyyy" )
